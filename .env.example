# Copy to .env and adjust. All values shown are the defaults.

# Where encrypted blobs and transfer records are kept.
QRT_STORAGE_DIR=storage

# Max ciphertext size per transfer (bytes) and total reserved across all transfers.
QRT_MAX_SIZE=10485760
QRT_MAX_STORAGE=1073741824

# Transfer lifetime in seconds.
QRT_DEFAULT_TTL=3600
QRT_MIN_TTL=60
QRT_MAX_TTL=86400

# QR display speed (frames per second).
QRT_DEFAULT_FPS=10
QRT_MAX_FPS=15

# Seconds between expiry sweeps.
QRT_CLEANUP_INTERVAL=60

# Transfer creations per client IP per minute (0 disables).
QRT_CREATE_RATE_LIMIT=20

# Redirect/reject plain HTTP. Disable only for localhost development.
QRT_ENFORCE_HTTPS=true

QRT_HOST=0.0.0.0
QRT_PORT=8000

# Proxies trusted for X-Forwarded-For / X-Forwarded-Proto (comma-separated, or *).
QRT_TRUSTED_PROXIES=127.0.0.1

# Built-in TLS. Set both to serve HTTPS directly without a reverse proxy.
QRT_SSL_CERTFILE=
QRT_SSL_KEYFILE=

